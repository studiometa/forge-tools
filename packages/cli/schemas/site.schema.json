{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@studiometa/forge-cli/schemas/site.schema.json",
  "title": "Forge site",
  "description": "A Laravel Forge site for `forge sites apply`. A key that is absent is not managed. Only server and domain are required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "domain"],
  "properties": {
    "$schema": { "type": "string" },
    "server": {
      "description": "Server name (exact match) or ID.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "domain": {
      "description": "Site name on Forge, e.g. www.example.com (exact match).",
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "description": "Domains to add to the site. Aliases are added, never removed.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "type": {
      "description": "Site type, used to create the site.",
      "enum": [
        "laravel",
        "symfony",
        "statamic",
        "wordpress",
        "phpmyadmin",
        "php",
        "nextjs",
        "nuxtjs",
        "static-html",
        "other",
        "custom"
      ]
    },
    "php": {
      "description": "PHP version, e.g. php83.",
      "type": "string",
      "pattern": "^php\\d+$"
    },
    "webDirectory": {
      "description": "Web directory, relative to the site root, e.g. /public.",
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url"],
      "properties": {
        "provider": { "enum": ["github", "gitlab", "bitbucket", "gitlab-custom", "custom"] },
        "url": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "database": {
      "description": "Database and user, created when missing. A new user gets a random password, written into the site .env only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "user"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 }
      }
    },
    "env": {
      "description": ".env variables to add when missing. Existing values are never overwritten.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "workers": {
      "description": "Forge background processes of the site. [] deletes all the workers of the site.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "processes": { "type": "integer", "minimum": 1, "default": 1 },
          "directory": {
            "description": "Directory, absolute or relative to the site root. Default: the site root.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schedule": {
      "description": "Forge scheduled jobs of the site. [] deletes all the scheduled jobs of the site.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "frequency"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "frequency": {
            "enum": ["minutely", "hourly", "nightly", "weekly", "monthly", "reboot", "custom"]
          },
          "cron": {
            "description": "Cron expression, required with the custom frequency.",
            "type": "string",
            "minLength": 1
          }
        },
        "if": { "properties": { "frequency": { "const": "custom" } } },
        "then": { "required": ["cron"] },
        "else": { "not": { "required": ["cron"] } }
      }
    }
  }
}
